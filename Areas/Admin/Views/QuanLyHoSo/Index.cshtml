@using CongDichVuSinhVien.Helpers
@model List<CongDichVuSinhVien.Models.HoSoDichVu>
@{
    Layout = "_LayoutNiceAdmin";
    ViewData["Title"] = "Quản lý & Xét duyệt hồ sơ";
    string tt = ViewBag.TrangThaiHienTai ?? "";
}

<style>
    /* Tối ưu không gian bảng và Dropdown menu */
    .table-responsive {
        min-height: 380px;
        /* Đảm bảo menu dropdown mở xuống không bị cắt góc */
    }

    .table thead th {
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: #556270;
        background-color: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding-top: 14px;
        padding-bottom: 14px;
    }

    .table tbody td {
        padding-top: 13px;
        padding-bottom: 13px;
        vertical-align: middle;
    }

    .badge-status {
        font-size: 0.78rem;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 50rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .btn-action-dropdown {
        border-radius: 6px;
        font-size: 0.84rem;
        font-weight: 600;
        padding: 5px 12px;
        transition: all 0.2s;
    }

    .dropdown-menu-action {
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1) !important;
        border: 1px solid #f1f5f9;
        min-width: 190px;
    }

    .dropdown-menu-action .dropdown-item {
        font-size: 0.85rem;
        padding: 8px 16px;
        display: flex;
        align-items: center;
    }

    .dropdown-menu-action .dropdown-item:hover {
        background-color: #f8fafc;
    }
</style>

<!-- TIÊU ĐỀ TRANG -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-1" style="color: #012970;">QUẢN LÝ &amp; XÉT DUYỆT HỒ SƠ</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                </li>
                <li class="breadcrumb-item active">Xét duyệt hồ sơ</li>
            </ol>
        </nav>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
        </a>
    </div>
</div>

<!-- THÔNG BÁO FLASH MESSAGE -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
        <span>@TempData["Warning"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KHỐI BỘ LỌC TÌM KIẾM -->
<div class="card card-nice p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control border-start-0"
                       placeholder="Tìm theo mã hồ sơ, MSSV, tên sinh viên hoặc thủ tục..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Chờ tiếp nhận" selected="@(tt == "Chờ tiếp nhận")">⏳ Chờ tiếp nhận</option>
                <option value="Đang xử lý" selected="@(tt == "Đang xử lý")">⚙️ Đang xử lý</option>
                <option value="Hoàn thành" selected="@(tt == "Hoàn thành")">✅ Hoàn thành / Đã duyệt</option>
                <option value="Từ chối" selected="@(tt == "Từ chối")">❌ Từ chối</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100 fw-semibold" style="background-color: #4154f1;">
                <i class="bi bi-funnel me-1"></i>Lọc dữ liệu
            </button>
        </div>
        <div class="col-md-2 text-end">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Xóa lọc</a>
        </div>
    </form>
</div>

<!-- BẢNG DANH SÁCH HỒ SƠ -->
<div class="card card-nice p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3">MÃ HỒ SƠ</th>
                    <th>SINH VIÊN</th>
                    <th>THỦ TỤC</th>
                    <th>HÌNH THỨC NHẬN</th>
                    <th>NGÀY NỘP</th>
                    <th class="text-center">TRẠNG THÁI</th>
                    <th class="text-center pe-3">HÀNH ĐỘNG</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            Không tìm thấy hồ sơ nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var hs in Model)
                    {
                        bool isBuuDien = hs.LyDoXin.Contains("CHUYỂN PHÁT NHANH");

                        <tr>
                            <!-- 1. Mã hồ sơ -->
                            <td class="ps-3 fw-bold text-primary font-monospace">
                                @hs.MaTraCuu
                            </td>

                            <!-- 2. Sinh viên -->
                            <td>
                                <div class="fw-bold text-dark">@hs.MaSinhVienNavigation?.MaNguoiDungNavigation?.HoTen</div>
                                <div class="small text-muted">
                                    MSSV: <span class="fw-semibold text-secondary">@hs.MaSinhVien</span>
                                    @(string.IsNullOrEmpty(hs.MaSinhVienNavigation?.LopHoc) ? "" : $" | Lớp:                           {hs.MaSinhVienNavigation?.LopHoc}")
                                </div>
                            </td>

                            <!-- 3. Thủ tục -->
                            <td>
                                <div class="fw-semibold text-dark">@hs.MaDichVuNavigation?.TenDichVu</div>
                                <small class="text-muted"><i
                                    class="bi bi-building me-1"></i>@hs.MaDichVuNavigation?.DonViXuLy</small>
                                </td>

                                <!-- 4. Hình thức nhận -->
                                <td>
                                    @if (isBuuDien)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-truck me-1"></i>Chuyển phát bưu điện
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            <i class="bi bi-building me-1"></i>Nhận tại quầy
                                        </span>
                                    }
                                </td>

                                <!-- 5. Ngày nộp -->
                                <td class="small text-muted">
                                    @hs.NgayNop?.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <!-- 6. Trạng thái (Màu sắc chuẩn rõ nét) -->
                                <td class="text-center">
                                    @if (hs.TrangThai == "Chờ tiếp nhận")
                                    {
                                        <span
                                            class="badge bg-warning-subtle text-warning-emphasis px-3 py-2 rounded-pill text-nowrap fw-semibold">
                                            Chờ tiếp nhận
                                        </span>
                                    }
                                    else if (hs.TrangThai == "Đang xử lý")
                                    {
                                        <span
                                            class="badge bg-info-subtle text-info-emphasis px-3 py-2 rounded-pill text-nowrap fw-semibold">
                                            Đang xử lý
                                        </span>
                                    }
                                    else if (hs.TrangThai == "Hoàn thành" || hs.TrangThai == "Đã duyệt")
                                    {
                                        <span
                                            class="badge bg-success-subtle text-success px-3 py-2 rounded-pill text-nowrap fw-semibold">
                                            Hoàn thành
                                        </span>
                                    }
                                    else if (hs.TrangThai == "Từ chối")
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill text-nowrap fw-semibold">
                                            Từ chối
                                        </span>
                                    }
                                    else
                                    {
                                        <span
                                            class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill text-nowrap fw-semibold">
                                            @hs.TrangThai
                                        </span>
                                    }
                                </td>

                                <!-- 7. HÀNH ĐỘNG DẠNG DROPDOWN GỌN GÀNG -->
                                <td class="text-center pe-3">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-primary dropdown-toggle btn-action-dropdown shadow-sm"
                                                type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                                data-bs-boundary="viewport">
                                            <i class="bi bi-gear-fill me-1"></i>Thao tác
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-action shadow">
                                            <!-- Xem chi tiết (luôn có) -->
                                            <li>
                                                <a class="dropdown-item text-primary" href="#" data-bs-toggle="modal"
                                                   data-bs-target="#modalDetail_@hs.MaHoSo">
                                                    <i class="bi bi-eye text-primary me-2"></i>Xem chi tiết
                                                </a>
                                            </li>

                                            <!-- Tiếp nhận hồ sơ -->
                                            @if (hs.TrangThai == "Chờ tiếp nhận" && User.HasPermission("Applications.Edit"))
                                            {
                                                <li>
                                                    <form id="formTiepNhan_@hs.MaHoSo" asp-area="Admin" asp-controller="QuanLyHoSo"
                                                          asp-action="TiepNhan" asp-route-id="@hs.MaHoSo" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item text-info fw-semibold">
                                                            <i class="bi bi-hand-index-thumb text-info me-2"></i>Tiếp nhận hồ sơ
                                                        </button>
                                                    </form>
                                                </li>
                                            }

                                            <!-- Phê duyệt -->
                                            @if ((hs.TrangThai == "Chờ tiếp nhận" || hs.TrangThai == "Đang xử lý") &&
                                    User.HasPermission("Applications.Approve"))
                                            {
                                                <li>
                                                    <a class="dropdown-item text-success fw-semibold" href="#" data-bs-toggle="modal"
                                                       data-bs-target="#modalApprove_@hs.MaHoSo">
                                                        <i class="bi bi-check-circle-fill text-success me-2"></i>Phê duyệt hoàn thành
                                                    </a>
                                                </li>
                                            }

                                            <!-- Từ chối -->
                                            @if ((hs.TrangThai == "Chờ tiếp nhận" || hs.TrangThai == "Đang xử lý") &&
                                    User.HasPermission("Applications.Reject"))
                                            {
                                                <li>
                                                    <hr class="dropdown-divider my-1">
                                                </li>
                                                <li>
                                                    <a class="dropdown-item text-danger" href="#" data-bs-toggle="modal"
                                                       data-bs-target="#modalReject_@hs.MaHoSo">
                                                        <i class="bi bi-x-circle-fill text-danger me-2"></i>Từ chối giải quyết
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>

                            <!-- ================= MODAL 1: XEM CHI TIẾT HỒ SƠ ================= -->
                            <div class="modal fade" id="modalDetail_@hs.MaHoSo" tabindex="-1">
                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">
                                        <div class="modal-header text-white" style="background-color: #012970;">
                                            <h6 class="modal-title fw-bold"><i class="bi bi-info-circle me-2"></i>CHI TIẾT HỒ SƠ
                                                @hs.MaTraCuu</h6>
                                                <button type="button" class="btn-close btn-close-white"
                                                        data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body p-4 text-start">
                                                <div class="row g-3 mb-3">
                                                    <div class="col-md-6"><strong>Thủ tục:</strong> @hs.MaDichVuNavigation?.TenDichVu
                                                    </div>
                                                    <div class="col-md-6"><strong>Đơn vị:</strong> @hs.MaDichVuNavigation?.DonViXuLy
                                                    </div>
                                                    <div class="col-md-6"><strong>Họ tên:</strong>
                                                        @hs.MaSinhVienNavigation?.MaNguoiDungNavigation?.HoTen</div>
                                                        <div class="col-md-6"><strong>MSSV:</strong> @hs.MaSinhVien (Lớp:
                                                            @hs.MaSinhVienNavigation?.LopHoc)</div>
                                                            <div class="col-md-6"><strong>Khoa/Viện:</strong> @hs.MaSinhVienNavigation?.KhoaVien
                                                            </div>
                                                            <div class="col-md-6"><strong>Thời gian nộp:</strong>
                                                                @hs.NgayNop?.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                                            </div>

                                                            <div class="p-3 bg-light rounded border mb-3">
                                                                <h6 class="fw-bold text-primary mb-2">Chi tiết đề nghị &amp; Thông tin nhận kết quả:
                                                                </h6>
                                                                <div style="white-space: pre-line; line-height: 1.6;">@hs.LyDoXin</div>
                                                            </div>

                                                            <div class="mb-3">
                                                                <strong>Tệp minh chứng đính kèm:</strong>
                                                                @if (!string.IsNullOrEmpty(hs.TepDinhKem))
                                                                {
                                                                    <a href="@hs.TepDinhKem" target="_blank"
                                                                       class="btn btn-sm btn-outline-primary ms-2">
                                                                        <i class="bi bi-download me-1"></i> Tải về tệp minh chứng
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted fst-italic ms-2">Không có tệp đính kèm</span>
                                                                }
                                                            </div>

                                                            @if (!string.IsNullOrEmpty(hs.GhiChuCanBo))
                                                            {
                                                                <div class="alert alert-secondary py-2 mb-0">
                                                                    <strong>Thông tin phản hồi từ cán bộ:</strong> @hs.GhiChuCanBo
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary btn-sm"
                                                                    data-bs-dismiss="modal">Đóng</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- ================= MODAL 2: DUYỆT HỒ SƠ ================= -->
                                            <!-- ================= MODAL 2: DUYỆT HỒ SƠ (CÓ LỊCH HẸN TRẢ) ================= -->
                                            <div class="modal fade" id="modalApprove_@hs.MaHoSo" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 shadow">
                                                        <form asp-area="Admin" asp-controller="QuanLyHoSo" asp-action="PheDuyet" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="maHoSo" value="@hs.MaHoSo" />
                                                            <div class="modal-header bg-success text-white">
                                                                <h6 class="modal-title fw-bold"><i class="bi bi-check2-circle me-1"></i>PHÊ DUYỆT HỒ
                                                                    SƠ @hs.MaTraCuu</h6>
                                                                    <button type="button" class="btn-close btn-close-white"
                                                                            data-bs-dismiss="modal"></button>
                                                                </div>
                                                                <div class="modal-body text-start p-4">
                                                                    @if (isBuuDien)
                                                                    {
                                                                        <!-- TH1: Gửi bưu điện -->
                                                                        <div class="alert alert-success py-2 small mb-3">
                                                                            <i class="bi bi-truck me-1"></i> <strong>Hồ sơ gửi Bưu điện:</strong> Vui lòng
                                                                            chuẩn bị bản giấy có dấu đỏ tươi và nhập mã vận đơn để sinh viên tra cứu bưu
                                                                            phẩm.
                                                                        </div>
                                                                        <div class="mb-3">
                                                                            <label class="form-label fw-semibold small">Mã vận đơn / Bưu gửi (EMS /
                                                                                ViettelPost) <span class="text-danger">*</span></label>
                                                                                <input type="text" name="maVanDon" class="form-control"
                                                                                       placeholder="Ví dụ: VNPOST-EM982348123VN" required />
                                                                            </div>
                                                                            <div class="mb-3">
                                                                                <label class="form-label fw-semibold small">Đơn vị vận chuyển</label>
                                                                                <input type="text" name="donViVanChuyen" class="form-control"
                                                                                       value="Bưu điện Việt Nam (VNPost / EMS)" />
                                                                            </div>
                                                                            <div class="mb-3">
                                                                                <label class="form-label fw-semibold small">Ngày dự kiến bưu điện phát
                                                                                    tới</label>
                                                                                    <input type="date" name="ngayHenTra" class="form-control"
                                                                                           value="@DateTime.Now.AddDays(2).ToString("yyyy-MM-dd")" />
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label fw-semibold small">Ghi chú bưu gửi</label>
                                                                                    <textarea name="ghiChu" class="form-control" rows="2"
                                                                                              placeholder="Ví dụ: Đã niêm phong bản giấy có dấu đỏ và bàn giao bưu tá."></textarea>
                                                                                </div>
                                                                            }
                    else
                                                                            {
                                                                                <!-- TH2: Nhận tại quầy một cửa -->
                                                                                <div class="alert alert-primary py-2 small mb-3">
                                                                                    <i class="bi bi-building me-1"></i> <strong>Hồ sơ nhận tại quầy:</strong> Vui
                                                                                    lòng chuẩn bị bản giấy có dấu đỏ tươi và thiết lập lịch hẹn sinh viên đến nhận.
                                                                                </div>

                                                                                <!-- Ô CHỌN LỊCH HẸN TRẢ (NGÀY & GIỜ) -->
                                                                                <div class="mb-3">
                                                                                    <label class="form-label fw-semibold small">
                                                                                        <i class="bi bi-calendar2-event text-primary me-1"></i>Lịch hẹn trả kết quả
                                                                                        (Ngày &amp; Giờ hẹn) <span class="text-danger">*</span>
                                                                                    </label>
                                                                                    <input type="datetime-local" name="ngayHenTra"
                                                                                           class="form-control fw-bold text-primary" required
                                                                                           value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-ddT08:30")" />
                                                                                    <div class="form-text small text-muted">Thời điểm sinh viên có thể đến phòng Một
                                                                                        cửa nhận kết quả.</div>
                                                                                    </div>

                                                                                    <div class="mb-3">
                                                                                        <label class="form-label fw-semibold small">Địa điểm &amp; Lời dặn dò <span
                                                                                            class="text-danger">*</span></label>
                                                                                            <textarea name="ghiChu" class="form-control" rows="3" required
                                                                                                      placeholder="Ví dụ: Đã in và đóng dấu đỏ bản cứng. Mời sinh viên mang theo Thẻ SV đến Bàn số 1 - Phòng Một cửa (Tầng 1 Nhà A1) để nhận kết quả."></textarea>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                                <div class="modal-footer bg-light">
                                                                                    <button type="button" class="btn btn-secondary btn-sm"
                                                                                            data-bs-dismiss="modal">Hủy</button>
                                                                                    <button type="submit" class="btn btn-success btn-sm fw-bold px-3">
                                                                                        <i class="bi bi-check-lg me-1"></i>Xác nhận Phê duyệt
                                                                                    </button>
                                                                                </div>
                                                                            </form>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <!-- ================= MODAL 3: TỪ CHỐI HỒ SƠ ================= -->
                                                                <div class="modal fade" id="modalReject_@hs.MaHoSo" tabindex="-1">
                                                                    <div class="modal-dialog modal-dialog-centered">
                                                                        <div class="modal-content border-0 shadow">
                                                                            <form asp-area="Admin" asp-controller="QuanLyHoSo" asp-action="TuChoi" method="post">
                                                                                @Html.AntiForgeryToken()
                                                                                <input type="hidden" name="maHoSo" value="@hs.MaHoSo" />
                                                                                <div class="modal-header bg-danger text-white">
                                                                                    <h6 class="modal-title fw-bold"><i class="bi bi-x-circle me-1"></i>TỪ CHỐI HỒ SƠ
                                                                                        @hs.MaTraCuu</h6>
                                                                                        <button type="button" class="btn-close btn-close-white"
                                                                                                data-bs-dismiss="modal"></button>
                                                                                    </div>
                                                                                    <div class="modal-body text-start p-4">
                                                                                        <div class="mb-3">
                                                                                            <label class="form-label fw-semibold small">Lý do từ chối cụ thể <span
                                                                                                class="text-danger">*</span></label>
                                                                                                <textarea name="lyDoTuChoi" class="form-control" rows="3" required
                                                                                                          placeholder="Ví dụ: Thiếu giấy tờ minh chứng, địa chỉ nhận thư không rõ ràng..."></textarea>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="modal-footer">
                                                                                            <button type="button" class="btn btn-secondary btn-sm"
                                                                                                    data-bs-dismiss="modal">Hủy</button>
                                                                                            <button type="submit" class="btn btn-danger btn-sm fw-bold px-3">Xác nhận Từ
                                                                                                chối</button>
                                                                                            </div>
                                                                                        </form>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                            <!-- THANH PHÂN TRANG CHO QUẢN LÝ HỒ SƠ -->
                                                            @if (ViewBag.TongSoTrang > 1)
                                                            {
                                                                <div class="d-flex justify-content-between align-items-center p-3 border-top bg-light">
                                                                    <small class="text-muted">Tổng cộng: <b>@ViewBag.TongSoBanGhi</b> hồ sơ</small>
                                                                    <nav>
                                                                        <ul class="pagination pagination-sm mb-0">
                                                                            <li class="page-item @(ViewBag.TrangHienTai <= 1 ? "disabled" : "")">
                                                                                <a class="page-link"
                                                                                   href="@Url.Action("Index", new { trang = ViewBag.TrangHienTai - 1, trangThai = ViewBag.TrangThaiHienTai, tuKhoa = ViewBag.TuKhoa })">Trước</a>
                                                                            </li>
                                                                            @for (int i = 1; i <= ViewBag.TongSoTrang; i++)
                                                                            {
                                                                                <li class="page-item @(i == ViewBag.TrangHienTai ? "active" : "")">
                                                                                    <a class="page-link"
                                                                                       href="@Url.Action("Index", new { trang = i, trangThai = ViewBag.TrangThaiHienTai, tuKhoa = ViewBag.TuKhoa })">@i</a>
                                                                                </li>
                                                                            }
                                                                            <li class="page-item @(ViewBag.TrangHienTai >= ViewBag.TongSoTrang ? "disabled" : "")">
                                                                                <a class="page-link"
                                                                                   href="@Url.Action("Index", new { trang = ViewBag.TrangHienTai + 1, trangThai = ViewBag.TrangThaiHienTai, tuKhoa = ViewBag.TuKhoa })">Sau</a>
                                                                            </li>
                                                                        </ul>
                                                                    </nav>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>