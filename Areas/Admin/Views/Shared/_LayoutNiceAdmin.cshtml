@using CongDichVuSinhVien.Helpers
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NiceAdmin Hệ Thống</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Chart.js & SweetAlert2 cho AJAX -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
            :root {
                --sidebar-width: 270px;
                --admin-blue: #012970;
                --admin-primary: #4154f1;
            }

            body {
                font-family: "Segoe UI", Roboto, sans-serif;
                background: #f6f9ff;
                color: #444;
            }

            /* Topbar Header */
            .header-nice {
                height: 60px;
                box-shadow: 0px 2px 20px rgba(1, 41, 112, 0.08);
                background: #fff;
                padding: 0 20px;
                z-index: 997;
                transition: all 0.3s;
            }

            .toggle-sidebar-btn {
                font-size: 26px;
                cursor: pointer;
                color: var(--admin-blue);
            }

            /* Sidebar */
            .sidebar-nice {
                width: var(--sidebar-width);
                top: 60px;
                bottom: 0;
                left: 0;
                background: #fff;
                box-shadow: 0px 0px 20px rgba(1, 41, 112, 0.08);
                position: fixed;
                padding: 15px 10px;
                overflow-y: auto;
                transition: all 0.3s;
                z-index: 996;
            }

            .sidebar-nice .nav-heading {
                font-size: 11px;
                text-transform: uppercase;
                color: #899bbd;
                font-weight: 700;
                margin: 15px 0 5px 12px;
            }

            .sidebar-nice .nav-link {
                display: flex;
                align-items: center;
                font-size: 15px;
                font-weight: 600;
                color: #012970;
                padding: 10px 14px;
                border-radius: 6px;
                text-decoration: none;
                margin-bottom: 4px;
                transition: 0.2s;
            }

            .sidebar-nice .nav-link i {
                font-size: 18px;
                margin-right: 12px;
                color: #899bbd;
            }

            .sidebar-nice .nav-link:hover {
                color: var(--admin-primary);
                background: #f6f9ff;
            }
        
            /* TÔ ĐẬM MENU ĐANG CHỌN (ACTIVE) */
            .sidebar-nice .nav-link.active {
                color: var(--admin-primary) !important;
                background: #f0f4fb !important;
                font-weight: 700;
                border-left: 4px solid var(--admin-primary);
            }

            .sidebar-nice .nav-link.active i {
                color: var(--admin-primary) !important;
            }

            /* Thu gọn Sidebar */
            .main-content {
                margin-left: var(--sidebar-width);
                margin-top: 60px;
                padding: 25px;
                min-height: calc(100vh - 60px);
                transition: all 0.3s;
            }

            body.toggle-sidebar .sidebar-nice {
                left: calc(-1 * var(--sidebar-width));
            }

            body.toggle-sidebar .main-content {
                margin-left: 0;
            }

            .card-nice {
                border: none;
                border-radius: 8px;
                box-shadow: 0px 0 30px rgba(1, 41, 112, 0.08);
                background: #fff;
                margin-bottom: 25px;
            }
    </style>
</head>

<body>
    <header class="header-nice d-flex align-items-center justify-content-between fixed-top">
        <div class="d-flex align-items-center">
            <!-- NÚT THU GỌN SIDEBAR -->
            <i class="bi bi-list toggle-sidebar-btn me-3" id="btnToggleSidebar" title="Thu gọn / Mở rộng menu"></i>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="d-flex align-items-center text-decoration-none">
                <i class="bi bi-shield-check fs-3 text-primary me-2"></i>
                <span class="fs-5 fw-bold" style="color: #012970;">NICE ADMIN</span>
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-primary"
               target="_blank">
                <i class="bi bi-box-arrow-up-right me-1"></i> Trang Dịch vụ hành chính
            </a>
            <div class="dropdown">
                <button class="btn btn-light dropdown-toggle fw-semibold" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle text-primary me-1"></i> @User.Identity?.Name
                    <span
                    class="badge bg-primary ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                    <li>
                        <div class="dropdown-item-text text-muted small">Mã: @User.FindFirst("MaDinhDanh")?.Value</div>
                    </li>
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    <li><a class="dropdown-item text-danger" asp-area="" asp-controller="TaiKhoan"
                               asp-action="DangXuat"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- SIDEBAR VỚI ACTIVE MENU TỰ ĐỘNG -->
        <aside class="sidebar-nice">
            <ul class="list-unstyled mb-0">
                <li>
                    <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" asp-area="Admin"
                       asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid"></i><span>Tổng quan (Dashboard)</span>
                    </a>
                </li>

                <li class="nav-heading">TIẾP NHẬN &amp; XỬ LÝ</li>
                <li>
                    <a class="nav-link @(currentController == "QuanLyHoSo" ? "active" : "")" asp-area="Admin"
                       asp-controller="QuanLyHoSo" asp-action="Index">
                        <i class="bi bi-journal-check"></i><span>Quản lý &amp; Xét duyệt hồ sơ</span>
                    </a>
                </li>

                <li class="nav-heading">DANH MỤC &amp; TRỢ LÝ NLP</li>
                <li>
                    <a class="nav-link @(currentController == "QuanLyThuTuc" ? "active" : "")" asp-area="Admin"
                       asp-controller="QuanLyThuTuc" asp-action="Index">
                        <i class="bi bi-card-list"></i><span>Quản lý thủ tục hành chính</span>
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "QuanLyNlp" ? "active" : "")" asp-area="Admin"
                       asp-controller="QuanLyNlp" asp-action="Index">
                        <i class="bi bi-robot"></i><span>Bộ dữ liệu huấn luyện NLP</span>
                    </a>
                </li>

                @if (User.IsInRole("ADMIN") || User.IsInRole("QuanTri"))
                {
                    <li class="nav-heading">HỆ THỐNG QUẢN TRỊ</li>
                    <li>
                        <a class="nav-link @(currentController == "QuanLyNguoiDung" ? "active" : "")" asp-area="Admin"
                           asp-controller="QuanLyNguoiDung" asp-action="Index">
                            <i class="bi bi-people"></i><span>Người dùng hệ thống</span>
                        </a>
                    </li>
                }
            </ul>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
                // SỰ KIỆN THU GỌN / MỞ RỘNG SIDEBAR
                document.getElementById('btnToggleSidebar').addEventListener('click', function () {
                    document.body.classList.toggle('toggle-sidebar');
                });
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>