@model List<CongDichVuSinhVien.Models.DuLieuHuanLuyenNlp>

<section class="hero-banner py-5"
         style="background: linear-gradient(135deg, #002b5b 0%, #005691 100%); color: #ffffff;">
    <div class="container text-center">
        <h2 class="fw-bold mb-2">HỆ THỐNG DỊCH VỤ HÀNH CHÍNH TRỰC TUYẾN SINH VIÊN</h2>
        <p class="text-light mb-4">Giải quyết nhanh gọn, công khai, minh bạch các thủ tục đào tạo &amp; chế độ sinh viên
        </p>
        
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Form gửi trực tiếp sang TroLyNlpController -->
                <form method="get" asp-controller="TroLyNlp" asp-action="TimKiem">
                    <div class="d-flex align-items-center bg-white rounded-3 p-1 shadow">
                        <i class="fa fa-robot text-primary fs-4 ms-3 me-2"></i>
                        <input type="text" name="cauHoi" value="@ViewBag.TuKhoaHienTai"
                               class="form-control border-0 shadow-none fs-6" placeholder="Tìm kiếm..." required />
                        <button type="submit" class="btn btn-primary px-4 fw-semibold"
                                style="background-color: #005691;">Tìm kiếm</button>
                    </div>
                </form>

                <!-- Danh sách gợi ý từ CSDL NLP -->
                @if (Model != null && Model.Any())
                {
                    <div class="mt-3 text-start">
                        <span class="text-light small fw-semibold me-2"><i class="fa fa-lightbulb text-warning me-1"></i>Gợi
                            ý câu hỏi:</span>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var nlp in Model)
                                {
                                    <a href="@Url.Action("TimKiem", "TroLyNlp", new { cauHoi = nlp.CauHoiMau })"
                                       class="badge bg-white text-dark text-decoration-none p-2 shadow-sm">
                                        @nlp.CauHoiMau
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>