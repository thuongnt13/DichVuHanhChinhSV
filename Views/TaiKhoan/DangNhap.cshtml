@model CongDichVuSinhVien.Models.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-3">
                <div class="card-header text-white text-center py-4" style="background-color: #002b5b;">
                    <i class="fa fa-user-lock fs-1 mb-2 text-info"></i>
                    <h5 class="fw-bold mb-0 text-uppercase">Đăng nhập một cửa điện tử</h5>
                    <small class="text-light">Dành cho Sinh viên, Cán bộ và Quản trị viên</small>
                </div>
                <div class="card-body p-4 bg-white">
                    <form asp-action="DangNhap" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert">
                        </div>

                        <div class="mb-3">
                            <label asp-for="TenDangNhap" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa fa-user text-muted"></i></span>
                                <input asp-for="TenDangNhap" class="form-control" placeholder="Tên đăng nhập hoặc MSSV"
                                       autofocus />
                            </div>
                            <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MatKhau" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa fa-lock text-muted"></i></span>
                                <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu" />
                            </div>
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="GhiNho" class="form-check-input" />
                            <label asp-for="GhiNho" class="form-check-label text-secondary small"></label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold text-uppercase"
                                style="background-color: #005691;">
                            Đăng nhập
                        </button>
                    </form>
                </div>
                <div class="card-footer text-center bg-light py-3 small text-muted">
                    Quên mật khẩu? Liên hệ phòng Công tác sinh viên để được cấp lại.
                </div>
            </div>
        </div>
    </div>
</div>