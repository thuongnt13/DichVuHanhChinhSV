@model List<CongDichVuSinhVien.Models.HoSoDichVu>
@{
    bool isSinhVien = ViewBag.IsSinhVien ?? false;
    string loai = ViewBag.Loai ?? "tatca";
    ViewData["Title"] = isSinhVien ? "Hồ sơ của tôi" : "Quản lý hồ sơ tiếp nhận";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold text-dark mb-1" style="color: #002b5b !important;">
                <i class="fa fa-folder-open me-2 text-primary"></i>
                @(isSinhVien ? "DANH SÁCH HỒ SƠ ĐÃ NỘP CỦA TÔI" : "TỔNG HỢP HỒ SƠ MỘT CỬA TOÀN TRƯỜNG")
            </h4>
            <small class="text-muted">
                @(loai == "hoanthanh" ? "Danh sách hồ sơ đã được phê duyệt và hoàn thành" : "Tất cả hồ sơ tiếp nhận trên hệ thống")
            </small>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="DanhSach" asp-route-loai="tatca"
               class="btn btn-sm @(loai == "tatca" ? "btn-primary" : "btn-outline-primary")">Tất cả hồ sơ</a>
            <a asp-action="DanhSach" asp-route-loai="hoanthanh"
               class="btn btn-sm @(loai == "hoanthanh" ? "btn-success" : "btn-outline-success")">Hồ sơ hoàn thành</a>
        </div>
    </div>

    <!-- Thanh tìm kiếm nhanh -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white">
        <form method="get" asp-action="DanhSach">
            <input type="hidden" name="loai" value="@loai" />
            <div class="input-group">
                <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control"
                       placeholder="Nhập mã tra cứu hoặc tên thủ tục để tìm nhanh..." />
                <button class="btn btn-primary px-4" type="submit" style="background-color: #005691;">Tìm kiếm</button>
            </div>
        </form>
    </div>

    <!-- Bảng thông tin chung -->
    <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary text-uppercase small">
                    <tr>
                        <th class="ps-3 py-3">Mã tra cứu</th>
                        <th>Tên thủ tục</th>
                        @if (!isSinhVien)
                        {
                            <th>Sinh viên nộp</th>
                        }
                        <th>Ngày nộp</th>
                        <th>Cán bộ phụ trách</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-3">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa fa-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Không có hồ sơ nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            string badgeClass = item.TrangThai switch
                            {
                                "Chờ tiếp nhận" => "bg-warning text-dark",
                                "Đang xử lý" => "bg-info text-dark",
                                "Hoàn thành" or "Đã duyệt" => "bg-success text-white",
                                "Từ chối" => "bg-danger text-white",
                                _ => "bg-secondary text-white"
                            };

                            <tr>
                                <!-- Mã tra cứu -->
                                <td class="ps-3 fw-bold text-primary font-monospace">
                                    @item.MaTraCuu
                                </td>

                                <!-- Tên thủ tục -->
                                <td>
                                    <div class="fw-semibold text-dark">@item.MaDichVuNavigation?.TenDichVu</div>
                                    <small class="text-muted">Đơn vị: @item.MaDichVuNavigation?.DonViXuLy</small>
                                </td>

                                <!-- Nếu là cán bộ xem: hiện tên + MSSV -->
                                @if (!isSinhVien)
                                {
                                    <td>
                                        <div>@item.MaSinhVienNavigation?.MaNguoiDungNavigation?.HoTen</div>
                                        <small class="badge bg-light text-secondary border">MSSV: @item.MaSinhVien</small>
                                    </td>
                                }

                                <!-- Ngày nộp -->
                                <td class="small text-muted">
                                    @item.NgayNop?.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <!-- Cán bộ phụ trách -->
                                <td class="small">
                                    @(item.MaCanBoXuLy ?? "Chưa phân công")
                                </td>

                                <!-- Trạng thái chung -->
                                <td class="text-center">
                                    <span class="badge @badgeClass px-2 py-1">@item.TrangThai</span>
                                </td>

                                <!-- Nút Xem chi tiết -->
                                <td class="text-end pe-3">
                                    <a asp-action="ChiTiet" asp-route-id="@item.MaHoSo"
                                       class="btn btn-sm btn-outline-primary px-3 fw-semibold">
                                        <i class="fa fa-eye me-1"></i> Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>